+		       ktime_ms_delta(ktime_get(), last_resume_complete);
+	if (remaining_ms > 0) {
+		pr_info("PM: waiting %lld ms since last resume before freezing CPUs\n",
+			remaining_ms);
+		msleep(remaining_ms);
+	}
