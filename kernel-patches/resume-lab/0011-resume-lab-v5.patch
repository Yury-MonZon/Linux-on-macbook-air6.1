+ *   inside suspend_enter(), before Enable_cpus/CPU bringup and before the
+ *   noirq/early/main device-resume phases), instead of after all of that
+ *   completes. Independent of pm_bringup_mode -- combine with mode 3 to
+ *   let the desktop's cold start overlap the *entire* AP bringup and
+ *   device-resume window, not just the small slice mode 3 alone can hide
+ *   behind. Filesystems stay frozen either way (filesystems_thaw() is
+ *   unaffected); s2idle and any early-error path that bypasses
+ *   Enable_cpus are unaffected too (userspace_thawed_early stays false,
+ *   so suspend_finish() thaws normally). Off by default.
+ */
+extern int pm_bringup_mode;
+extern int pm_affskip;
+extern int pm_cpufreq_defer;
+extern int pm_early_thaw;
