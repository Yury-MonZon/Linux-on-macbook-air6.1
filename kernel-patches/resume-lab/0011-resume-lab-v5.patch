+static DECLARE_WAIT_QUEUE_HEAD(pm_ap_bringup_wq);
+static bool pm_ap_bringup_pending;
+static struct task_struct *pm_ap_bringup_task;
+
+/*
+ * Deferred AP bringup worker (mode 1): complete the CPU bringup recorded
+ * in frozen_cpus in the background, after user space has been thawed and
+ * the console (screen) is back.
+ *
+ * Every CPU is brought up individually and fully sequentially (kick+wait
+ * +online in one _cpu_up() call, one CPU at a time; frozen_cpus is walked
+ * in cpu-number order). On this machine's frozen set ({cpu1, cpu3}) the
+ * primary (cpu1) therefore always finishes completely -- including its
+ * microcode-sensitive window -- before its own sibling (cpu3) is even
+ * kicked, so this mode has never actually had the SMT-ordering problem
+ * modes 2 shares. Its real, still-open risk is different: every one of
+ * these ONLINE transitions now races live, already-thawed userspace and
+ * a fully-resumed device tree, which is exactly the architecture the
+ * 2014 Lan Tianyu RFC used ("PM/CPU: Parallel enabling nonboot cpus with
+ * resume devices") and which Zijlstra/Wysocki rejected upstream for that
+ * reason (see upstream-submission.md). It stays in this lab specifically
+ * to reproduce that hazard class fairly, on this hardware, with the
+ * cpufreq ordering bug that also sank the RFC and 0004's first attempt
+ * now fixed (see the cpufreq_resume() call at the bottom of this
+ * function) -- so any misbehavior that remains in mode 1 isolates the
+ * live-userspace-race question on its own, rather than being conflated
+ * with a bug already known how to avoid.
+ */
+static int pm_ap_bringup_threadfn(void *unused)
+{
+	cpumask_var_t pending;
+	ktime_t t0, t1;
+	int cpu, error;
+
+	if (!alloc_cpumask_var(&pending, GFP_KERNEL))
+		return -ENOMEM;
+
+	set_freezable();
+	while (!kthread_should_stop()) {
+		wait_event_freezable(pm_ap_bringup_wq,
+				     pm_ap_bringup_pending ||
+				     kthread_should_stop());
+		if (kthread_should_stop())
+			break;
+
+		pm_ap_bringup_pending = false;
+
+		cpu_maps_update_begin();
+		cpumask_copy(pending, frozen_cpus);
+		cpu_maps_update_done();
+		if (cpumask_empty(pending))
+			continue;
+
+		pr_info("PM: bringing APs online in background\n");
+		t1 = ktime_get();
+
+		arch_thaw_secondary_cpus_begin();
+		for_each_cpu(cpu, pending) {
+			/* A nested suspend freezes us here, holding no locks. */
+			if (try_to_freeze())
+				break;
+
+			t0 = ktime_get();
+			trace_suspend_resume(TPS("CPU_ON"), cpu, true);
+			error = _cpu_up(cpu, 0, CPUHP_ONLINE);
+			trace_suspend_resume(TPS("CPU_ON"), cpu, false);
+			if (!error) {
+				pr_info("CPU%d is up (%lld ms, background)\n", cpu,
+					ktime_ms_delta(ktime_get(), t0));
+				cpu_maps_update_begin();
+				cpumask_clear_cpu(cpu, frozen_cpus);
+				cpu_maps_update_done();
+				continue;
+			}
+			pr_warn("Error taking CPU%d up: %d\n", cpu, error);
+		}
+		arch_thaw_secondary_cpus_end();
+
+		pr_info("PM: background bringup pass done in %lld ms\n",
+			ktime_ms_delta(ktime_get(), t1));
+
+		/*
+		 * Run the governor restart that was held back so it wouldn't
+		 * observe a still-frozen policy mid-walk (see
+		 * pm_resume_cpu_online_pending() above). Only once every
+		 * originally-frozen CPU actually made it to ONLINE -- if a
+		 * nested suspend broke the loop above early, frozen_cpus is
+		 * still non-empty and this correctly waits for a later pass.
+		 * cpufreq_resume() no-ops on its own (cpufreq_suspended
+		 * guard) if it already ran, so there is no harm in this being
+		 * reached more than once.
+		 */
+		if (cpumask_empty(frozen_cpus)) {
+			if (pm_cpufreq_defer)
+				cpufreq_resume();
+			mark_resume_complete();
+		}
+	}
+	free_cpumask_var(pending);
+	return 0;
