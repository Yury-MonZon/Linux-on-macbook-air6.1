+			pm_ap_bringup_task = NULL;
+			thaw_secondary_cpus();
+			return;
+		}
+	}
+	__cpu_hotplug_enable();
+	pm_ap_bringup_pending = true;
+	wake_up(&pm_ap_bringup_wq);
+}
